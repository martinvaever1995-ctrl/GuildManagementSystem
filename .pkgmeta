package-as: GuildManagementSystem

# AdventForever's handover version ships next to GMS for a while, so updating from
# AdventForever to GMS (same Wago project) keeps the old saved data loadable.
move-folders:
  GuildManagementSystem/Legacy/AdventForever: AdventForever

# Kept in the repository, left out of the download.
ignore:
  - docs
  - .github
  - .gitignore
  - .gitattributes
  - .pkgmeta
  - README.md

# Release notes (GitHub, Wago, WowUp) come from our own changelog, not the commit list.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
