# Keep line endings as they are, and never touch the bytes of fonts and images.
* text=auto eol=lf
*.tga binary
*.ttf binary
*.png binary

# Left out of GitHub's "Source code" downloads: only the addon itself goes in.
docs export-ignore
.github export-ignore
.gitattributes export-ignore
.gitignore export-ignore
.pkgmeta export-ignore
